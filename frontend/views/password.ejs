<%- include('partials/header') %>

<section class="auth-card">
  <% if (error) { %><p class="form-msg error auth-error" role="alert"><%= error %></p><% } %>
  <% if (success) { %><p class="form-msg ok auth-error" role="status"><%= success %></p><% } %>

  <form method="post" action="/account/password" class="auth-form">
    <label><%= t('รหัสผ่านปัจจุบัน') %>
      <span class="field field-lock field-pass"><input type="password" name="current" required autocomplete="current-password" autofocus><button type="button" class="pass-toggle" aria-pressed="false" aria-label="<%= t('แสดงรหัสผ่าน') %>"></button></span>
    </label>
    <div class="auth-row">
      <label><%= t('รหัสผ่านใหม่') %> <span class="optional"><%= t('(อย่างน้อย 6 ตัว)') %></span>
        <span class="field field-lock field-pass"><input type="password" name="password" required minlength="6" autocomplete="new-password"><button type="button" class="pass-toggle" aria-pressed="false" aria-label="<%= t('แสดงรหัสผ่าน') %>"></button></span>
      </label>
      <label><%= t('ยืนยันรหัสผ่านใหม่') %>
        <span class="field field-lock field-pass"><input type="password" name="confirm" required minlength="6" autocomplete="new-password"><button type="button" class="pass-toggle" aria-pressed="false" aria-label="<%= t('แสดงรหัสผ่าน') %>"></button></span>
      </label>
    </div>
    <button type="submit" class="btn-primary btn-block"><%= t('บันทึกรหัสผ่านใหม่') %></button>
  </form>
</section>

<%- include('partials/footer', { extraScripts: ['/js/auth-ui.js'] }) %>
