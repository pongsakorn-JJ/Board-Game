<%- include('partials/header') %>

<section class="auth-card">
  <% if (error) { %><p class="form-msg error auth-error" role="alert"><%= error %></p><% } %>
  <% if (success) { %><p class="form-msg ok auth-error" role="status"><%= success %></p><% } %>

  <form method="post" action="/account/password" class="auth-form">
    <label>รหัสผ่านปัจจุบัน
      <input type="password" name="current" required autocomplete="current-password" autofocus>
    </label>
    <div class="auth-row">
      <label>รหัสผ่านใหม่ <span class="optional">(อย่างน้อย 6 ตัว)</span>
        <input type="password" name="password" required minlength="6" autocomplete="new-password">
      </label>
      <label>ยืนยันรหัสผ่านใหม่
        <input type="password" name="confirm" required minlength="6" autocomplete="new-password">
      </label>
    </div>
    <button type="submit" class="btn-primary btn-block">บันทึกรหัสผ่านใหม่</button>
  </form>
</section>

<%- include('partials/footer') %>
