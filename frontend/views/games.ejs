<%- include('partials/header') %>

<%
  const difficultyTh = { Easy: t('ง่าย'), Medium: t('ปานกลาง'), Hard: t('ยาก') };
  const steps = (text) => String(text || '').split(/\r?\n/).map(s => s.trim()).filter(Boolean);
  const money = (n) => Number(n || 0).toLocaleString(locale);
%>

<% if (isCustomer) { %>
  <p class="hint"><%= t('เลือกเกมให้โต๊ะที่คุณกำลังเล่นได้ตลอดเวลา · 1 โต๊ะเล่นได้ครั้งละ 1 เกม — อยากเปลี่ยนเกมให้กด "คืนเกม" ก่อน แล้วเลือกเกมใหม่ · สต๊อกอัปเดตเรียลไทม์ (อัปเดตล่าสุด') %> <span id="last-updated">-</span>)</p>
  <section id="my-game-panel" class="my-game-panel" aria-live="polite"></section>
<% } else { %>
  <p class="hint"><%= user && user.role === 'admin'
    ? t('ลูกค้าเลือก/คืนเกมเองได้ที่เมนู "บอร์ดเกม" · พนักงานเปลี่ยนเกมให้ได้ที่หน้า "สถานะโต๊ะ"')
    : t('เข้าสู่ระบบเพื่อจองโต๊ะและเลือกเกม') %> <%= t('· 1 โต๊ะหยิบได้ครั้งละ 1 เกม · จำนวนคงเหลืออัปเดตเรียลไทม์ (อัปเดตล่าสุด') %> <span id="last-updated">-</span>)</p>
<% } %>

<div class="game-filter">
  <input type="search" id="game-search" placeholder="<%= t('ค้นหาชื่อเกม / หมวด...') %>" aria-label="<%= t('ค้นหาเกม') %>">
  <select id="game-players" aria-label="<%= t('จำนวนผู้เล่น') %>">
    <option value=""><%= t('ผู้เล่นกี่คนก็ได้') %></option>
    <% [2,3,4,5,6,8].forEach(n => { %><option value="<%= n %>"><%= t('เล่นได้ {n} คน', { n }) %></option><% }) %>
  </select>
  <label class="check-inline"><input type="checkbox" id="game-available-only"> <%= t('เฉพาะเกมที่ว่าง') %></label>
  <span class="muted" id="game-filter-count"></span>
</div>
<p class="empty" id="game-filter-empty" hidden><%= t('ไม่พบเกมที่ตรงกับเงื่อนไข') %></p>

<div class="game-grid">
  <% games.forEach(g => { const howto = steps(g.HowToPlay); %>
    <article class="game-card" data-game-id="<%= g.GameID %>" data-min="<%= g.MinPlayer %>" data-max="<%= g.MaxPlayer %>"
             data-search="<%= (g.Name + ' ' + (g.CategoryName || '')).toLowerCase() %>">
      <div class="game-cover">
        <img src="<%= g.ImageUrl || '/images/games/default.svg' %>" alt="<%= t('ภาพประกอบเกม {name}', { name: g.Name }) %>" loading="lazy"
             onerror="this.onerror=null;this.src='/images/games/default.svg'">
        <span class="stock-badge <%= g.AvailableQty > 0 ? 'in' : 'out' %>" data-stock>
          <%= g.AvailableQty > 0 ? t('ว่าง {a}/{b}', { a: g.AvailableQty, b: g.TotalQty }) : t('หมด 0/{b}', { b: g.TotalQty }) %>
        </span>
      </div>
      <div class="game-body">
        <h2 class="game-title"><%= g.Name %></h2>
        <div class="game-meta">
          <% if (g.CategoryName) { %><span class="badge" data-cat="<%= g.CategoryName %>"><%= g.CategoryName %></span><% } %>
          <span class="meta-item"><i class="mi mi-users"></i> <%= t('{min}–{max} คน', { min: g.MinPlayer, max: g.MaxPlayer }) %></span>
          <% if (g.PlayTime) { %><span class="meta-item"><i class="mi mi-clock"></i> <%= tr(g.PlayTime) %></span><% } %>
          <span class="meta-item"><i class="mi mi-gauge"></i> <%= t('ระดับ {level}', { level: difficultyTh[g.Difficulty] || g.Difficulty || '-' }) %></span>
        </div>
        <p class="game-desc"><%= g.ShortDescription ? tr(g.ShortDescription) : t('ยังไม่มีคำอธิบายเกมนี้ — เพิ่มได้ที่คอลัมน์ ShortDescription ในตาราง tbl_boardgame') %></p>
        <button type="button" class="btn-3d" data-open-3d hidden><%= t('🔍 ดูแบบ 3D 360° และอุปกรณ์ในกล่อง') %></button>
        <p class="game-inuse" data-inuse hidden></p>
        <% if (isCustomer) { %><div class="game-actions" data-my-actions></div><% } %>

        <details class="game-howto">
          <summary><i class="mi mi-play"></i> <%= t('วิธีเล่นแบบย่อ') %></summary>
          <% if (howto.length) { %>
            <ol><% howto.forEach(s => { %><li><%= tr(s) %></li><% }) %></ol>
          <% } else { %>
            <p class="empty"><%= t('ยังไม่มีคู่มือ — เพิ่มได้ที่คอลัมน์ HowToPlay (1 บรรทัด = 1 ขั้นตอน)') %></p>
          <% } %>
        </details>

        <div class="game-price">
          <span class="meta-item"><i class="mi mi-home"></i> <%= t('เช่ากลับบ้าน') %> <strong><%= money(g.OffsiteRentalRate) %></strong> <%= t('บาท') %></span>
          <span class="muted"><%= t('มัดจำ {amount} บาท', { amount: money(g.DepositAmount) }) %></span>
        </div>
      </div>
    </article>
  <% }) %>
</div>

<script>
  <% if (meJson) { %>window.__me = <%- meJson %>;<% } %>
  window.__initialState = <%- initialStateJson %>;
</script>

<%- include('partials/footer', { extraScripts: [
  'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js',
  'https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js',
  '/js/games3d.js'
] }) %>
